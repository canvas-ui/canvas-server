# Local runtime data — the server/ tree of a dev checkout holds every workspace
# and index on this machine (tens of GB); it must never enter the build context.
server/
users/
data/
multiverse/
runtimes/

# Dependencies (root and every workspace)
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Clients live in the canvas monorepo now; the web UI arrives as the prebuilt
# canvas-web package at install time. Nothing UI-related remains in this
# build context.

# Build outputs
build/
dist/
*.tgz
*.tar.gz

# Development files
.git/
.gitignore
.env
.env.local
.env.development
.env.test
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Documentation
docs/
*.md
README*

# Tests
tests/
test/
*.test.js
*.spec.js

# Temporary files
tmp/
temp/
