# Canvas Server — container configuration.
#
# `npm run docker:env` writes a .env from this file with your uid/gid and $HOME
# already filled in. Everything here is optional; the defaults keep all state
# under ./data/.

# ── Host user ───────────────────────────────────────────────────────────────
# The container runs as this uid:gid so bind-mounted dirs stay yours.
# `id -u` / `id -g`
CANVAS_UID=1000
CANVAS_GID=1000

# ── Ports ───────────────────────────────────────────────────────────────────
CANVAS_HOST_PORT=8001

# ── Admin user (created on first run) ───────────────────────────────────────
# The password and API token are printed to the log on first start. Leave the
# password empty to have one generated; set CANVAS_ADMIN_RESET=true to re-apply
# a changed password on the next start.
#
# The password must satisfy the server policy (server/config/auth.json — by
# default 8+ characters with a number and a special character). One that does
# not is refused with a message in the log and a generated password is used
# instead, so check the log if your own does not work.
CANVAS_ADMIN_EMAIL=admin@canvas.local
# Username. Empty → derived from the email's local part ("admin").
CANVAS_ADMIN_NAME=
CANVAS_ADMIN_PASSWORD=
CANVAS_ADMIN_RESET=false

# ── Host paths ──────────────────────────────────────────────────────────────
# Two mounts, two kinds of state. They are siblings inside the container
# (data/server and data/users), never nested, so each host path shows its real
# contents and both are complete on their own for a backup.

# Server runtime state: config/ (incl. the generated jwt.secret), db/, cache/,
# log/. Nothing here is meant to be edited by hand.
CANVAS_HOST_SERVER_HOME=./data/server

# Your data. This folder IS your home inside the container, so it holds
# Workspaces/, Roles/, Agents/ (created on first start) and a hidden .canvas/
# with your API tokens and client config:
#   CANVAS_HOST_USER_HOME=/home/you/Canvas
CANVAS_HOST_USER_HOME=./data/users/admin@canvas.local

# Multi-user instead: mount the whole users tree and let the server create one
# <email>/ subtree per user (give each its own dataset and quotas follow).
#   CANVAS_HOST_USER_HOME=/srv/canvas/users
#   CANVAS_USER_MOUNT=/opt/canvas-server/data/users
CANVAS_USER_MOUNT=

# Folder structure for new workspaces (the web UI can override per workspace):
#   home — the workspace root IS your drive, its internals hide in .workspace/,
#          so any existing folder can become a workspace and a workspace can be
#          synced by Dropbox/OneDrive or used as a roaming profile
#   full — the classic layout: db/, cache/, home/ … as visible children
CANVAS_WORKSPACE_LAYOUT=home

# Advanced, and single-user only: pinning the module roots to fixed paths makes
# EVERY user share them, replacing the per-user layout above. Leave empty.
CANVAS_USER_WORKSPACES=
CANVAS_USER_ROLES=
CANVAS_USER_AGENTS=

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
NODE_VERSION=22
CANVAS_CONTAINER_NAME=canvas-server

# Sessions survive restarts either way: an empty value makes the entrypoint
# generate one into <serverHome>/config/jwt.secret and reuse it.
CANVAS_JWT_SECRET=
CANVAS_JWT_TOKEN_EXPIRY=7d

# Embeddings (dense/hybrid search). false → store-only, search falls back to FTS.
CANVAS_EMBEDD_ENABLED=true
# An Ollama reachable from inside the container, e.g.
# http://host.docker.internal:11434 (add an extra_hosts entry on Linux) or a LAN host.
OLLAMA_HOST=

# ── Source identity (AGPL §13) ──────────────────────────────────────────────
# Where users of this instance get its source, and which revision is running.
# Served on every response as the X-Source-Code header and by GET /rest/v2/ping.
# `npm run docker:env` fills the commit in from `git rev-parse HEAD`, because
# .git/ is not in the image build context.
#
# RUNNING A MODIFIED CANVAS? Point CANVAS_SOURCE_URL at the repository that
# publishes YOUR changes. The AGPL entitles anyone using this server over a
# network to the corresponding source of the version actually running; leaving
# this pointed upstream, or removing it, does not satisfy that.
CANVAS_SOURCE_URL=https://github.com/canvas-ui/canvas-server
CANVAS_SOURCE_COMMIT=
