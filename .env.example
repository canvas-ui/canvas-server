# Canvas Server — container configuration.
#
# `npm run docker:env` writes a .env from this file with your uid/gid and $HOME
# already filled in. Everything here is optional; the defaults keep all state
# under ./data/.

# ── Host user ───────────────────────────────────────────────────────────────
# The container runs as this uid:gid so bind-mounted dirs stay yours.
# `id -u` / `id -g`
CANVAS_UID=1000
CANVAS_GID=1000

# ── Ports ───────────────────────────────────────────────────────────────────
CANVAS_HOST_PORT=8001

# ── Admin user (created on first run) ───────────────────────────────────────
# The password and API token are printed to the log on first start. Leave the
# password empty to have one generated; set CANVAS_ADMIN_RESET=true to re-apply
# a changed password on the next start.
CANVAS_ADMIN_EMAIL=admin@canvas.local
# Username. Empty → derived from the email's local part ("admin").
CANVAS_ADMIN_NAME=
CANVAS_ADMIN_PASSWORD=
CANVAS_ADMIN_RESET=false

# ── Host paths ──────────────────────────────────────────────────────────────
# Server state: config/, db/, cache/ — this is the dir worth backing up.
# `$HOME/.canvas/server/config` ends up exactly where you would expect it.
CANVAS_HOST_SERVER_HOME=./data/server

# Per-user homes are NOT a separate mount: they are server runtime state and
# live at <serverHome>/users, inside the directory above — on a personal install
# that is $HOME/.canvas/server/users ($HOME/.canvas/* outside server/ belongs to
# the client apps).

# The three per-user modules. Workspaces, roles and agents always live under
# their owner: <serverHome>/users/<email>/{Workspaces,Roles,Agents}. One user =
# one subtree, which is what a per-user dataset/quota/uid needs.
#
# These host folders are mounted ONTO that subtree for the admin user
# (CANVAS_ADMIN_EMAIL), so your own folders stay ordinary directories you can
# open in a file manager — without breaking the layout for anyone else:
#   CANVAS_HOST_WORKSPACES=/home/you/Workspaces
#   CANVAS_HOST_ROLES=/home/you/Roles
#   CANVAS_HOST_AGENTS=/home/you/Agents
CANVAS_HOST_WORKSPACES=./data/server/users/admin@canvas.local/Workspaces
CANVAS_HOST_ROLES=./data/server/users/admin@canvas.local/Roles
CANVAS_HOST_AGENTS=./data/server/users/admin@canvas.local/Agents

# Advanced, and single-user only: pinning the module roots to fixed paths makes
# EVERY user share them, replacing the per-user layout above. Leave empty.
CANVAS_USER_WORKSPACES=
CANVAS_USER_ROLES=
CANVAS_USER_AGENTS=

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
NODE_VERSION=22
CANVAS_CONTAINER_NAME=canvas-server

# Sessions survive restarts either way: an empty value makes the entrypoint
# generate one into <serverHome>/config/jwt.secret and reuse it.
CANVAS_JWT_SECRET=
CANVAS_JWT_TOKEN_EXPIRY=7d

# Embeddings (dense/hybrid search). false → store-only, search falls back to FTS.
CANVAS_EMBEDD_ENABLED=true
# An Ollama reachable from inside the container, e.g.
# http://host.docker.internal:11434 (add an extra_hosts entry on Linux) or a LAN host.
OLLAMA_HOST=
