# npm 12 defaults allow-git/allow-remote to "none", which refuses our
# root-level git deps (canvas-synapsd, canvas-stored — github:...#main) and the
# canvas-web release tarball URL with EALLOWGIT/EALLOWREMOTE. "root" re-allows
# exactly the dependency types THIS project declares at its root while keeping
# the supply-chain protection for transitive deps. If a box still fails (npm
# has open bugs around root-level exemptions with linked install strategies or
# registry mirrors), loosen to "all" locally — do not loosen it here first.
allow-git=root
allow-remote=root

# onnxruntime-node reaches this tree only transitively (canvas-synapsd ->
# fastembed), and only until synapsd >= 3.18.0 lands and drops fastembed. That
# 1.21 script downloads the CUDA EP only when it detects CUDA, so this is
# belt-and-braces rather than the fix it once was: the copy that actually broke
# deploys was 1.24.x under @huggingface/transformers, and that left with
# canvas-inferd when inference moved into its own process. The load-bearing
# skip now lives in canvas-inferd/.npmrc.
onnxruntime-node-install=skip
onnxruntime-node-install-cuda=skip
