# npm 12 defaults allow-git/allow-remote to "none", which refuses our
# root-level git deps (canvas-synapsd, canvas-stored — github:...#main) and the
# canvas-web release tarball URL with EALLOWGIT/EALLOWREMOTE. "root" re-allows
# exactly the dependency types THIS project declares at its root while keeping
# the supply-chain protection for transitive deps. If a box still fails (npm
# has open bugs around root-level exemptions with linked install strategies or
# registry mirrors), loosen to "all" locally — do not loosen it here first.
allow-git=root
allow-remote=root

# onnxruntime-node's postinstall downloads the CUDA 12 execution-provider
# binaries from a Microsoft NuGet CDN. On linux/x64 the 1.24.x script (pulled in
# by @huggingface/transformers via canvas-inferd) requests that manifest
# UNCONDITIONALLY — no CUDA detection — so a CPU-only box still reaches out, and
# a blocked or slow egress path fails `npm ci` outright with ETIMEDOUT. The CPU
# runtime we actually use ships inside the package; only the CUDA EP is fetched.
# Two keys because 1.21 (our direct dep) reads the deprecated *_cuda name and
# 1.24 reads the new one. Drop these if the server ever runs on a GPU box.
onnxruntime-node-install=skip
onnxruntime-node-install-cuda=skip
