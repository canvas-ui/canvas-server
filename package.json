{
  "name": "canvas-server",
  "productName": "Canvas Server",
  "version": "2.2.0",
  "description": "Context layer on top of your unstructured universe",
  "main": "./src/init.js",
  "type": "module",
  "scripts": {
    "start": "node ./src/init.js",
    "dev": "cross-env NODE_ENV=development LOG_LEVEL=debug node ./src/init.js",
    "update-submodules": "git submodule update --init --remote && git submodule foreach \"git add .\" && npm install --ignore-scripts && git add package-lock.json",
    "build": "npm run build -w src/ui/web",
    "postinstall": "npm run build -w src/ui/web",
    "lint": "eslint \"**/*.{js,ts}\"",
    "lint:fix": "eslint \"**/*.{js,ts}\" --fix",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "workspaces": [
    ".",
    "packages/api-client",
    "src/core/agent",
    "src/ui/cli",
    "src/ui/web",
    "src/ui/shell",
    "src/services/synapsd",
    "src/services/neurald",
    "src/services/stored",
    "src/services/embedd",
    "extensions/browser-extensions"
  ],
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@anthropic-ai/sdk": "0.104.1",
    "csstype": "3.2.3",
    "fast-jwt": "6.2.4",
    "fast-uri": "3.1.2",
    "@mariozechner/pi-ai": {
      "@anthropic-ai/sdk": "0.104.1"
    },
    "dockerode": {
      "uuid": "11.1.1"
    },
    "utf7": {
      "semver": "^5.7.2"
    }
  },
  "author": "me@idnc.sk",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@fastify/auth": "^4.6.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/error": "^3.4.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@slack/web-api": "^7.15.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "conf": "^14.0.0",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "dockerode": "^4.0.9",
    "dotenv": "^17.3.1",
    "eventemitter2": "^6.4.9",
    "fastify": "^4.29.1",
    "fastify-socket.io": "^5.1.0",
    "get-folder-size": "^5.0.0",
    "imap": "^0.8.19",
    "imapflow": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "ldapjs": "^3.0.7",
    "lmdb": "^3.5.2",
    "mailparser": "^3.9.9",
    "nanoid": "^5.1.7",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.3",
    "onnxruntime-node": "1.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "randomcolor": "^0.6.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "ulid": "^3.0.2",
    "undici": "^8.7.0",
    "uuid": "^11.1.1",
    "validator": "^13.15.26",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/socket.io-client": "^3.0.0",
    "eventsource": "^4.1.0",
    "globals": "^17.4.0",
    "node-fetch": "^3.3.2"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "onnxruntime-node@1.24.3": true,
    "onnxruntime-node@1.21.0": true,
    "sharp@0.34.5": true,
    "bun@1.3.14": true,
    "cpu-features@0.0.10": true,
    "fastify-socket.io@5.1.0": true,
    "koffi@2.16.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.5": true,
    "roaring@2.7.0": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true
  }
}
