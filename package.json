{
  "name": "canvas-server",
  "productName": "Canvas Server",
  "version": "2.1.3",
  "description": "Context layer on top of your unstructured universe",
  "main": "./src/init.js",
  "type": "module",
  "scripts": {
    "start": "node ./src/init.js",
    "dev": "cross-env NODE_ENV=development LOG_LEVEL=debug node ./src/init.js",
    "update-submodules": "git submodule update --init --remote && git submodule foreach \"git add .\"",
    "build": "npm run build -w src/ui/web",
    "postinstall": "npm run build -w src/ui/web",
    "lint": "eslint \"**/*.{js,ts}\"",
    "lint:fix": "eslint \"**/*.{js,ts}\" --fix"
  },
  "workspaces": [
    ".",
    "packages/api-client",
    "src/core/agent",
    "src/ui/cli",
    "src/ui/web",
    "src/ui/shell",
    "src/services/synapsd",
    "src/services/neurald",
    "src/services/stored",
    "extensions/browser-extensions"
  ],
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@anthropic-ai/sdk": "0.104.1",
    "csstype": "3.2.3",
    "fast-jwt": "6.2.4",
    "fast-uri": "3.1.2",
    "semver": "5.7.2",
    "tar": "7.5.16",
    "fastembed": {
      "tar": "$tar"
    },
    "@mariozechner/pi-ai": {
      "@anthropic-ai/sdk": "0.104.1"
    },
    "dockerode": {
      "uuid": "11.1.1"
    }
  },
  "author": "me@idnc.sk",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@fastify/auth": "^4.6.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/error": "^3.4.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^6.12.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@slack/web-api": "^7.15.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "conf": "^14.0.0",
    "cross-env": "^10.1.0",
    "dockerode": "^4.0.9",
    "dotenv": "^17.3.1",
    "eventemitter2": "^6.4.9",
    "fastify": "^4.29.1",
    "fastify-socket.io": "^5.1.0",
    "imap": "^0.8.19",
    "imapflow": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "ldapjs": "^3.0.7",
    "lmdb": "^3.5.2",
    "mailparser": "^3.9.9",
    "nanoid": "^5.1.7",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^8.0.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "randomcolor": "^0.6.2",
    "socket.io": "^4.8.3",
    "ulid": "^3.0.2",
    "uuid": "^11.1.1",
    "validator": "^13.15.26",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/socket.io-client": "^3.0.0",
    "eventsource": "^4.1.0",
    "globals": "^17.4.0",
    "node-fetch": "^3.3.2"
  }
}
