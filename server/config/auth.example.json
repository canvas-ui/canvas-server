{
  "strategies": {
    "local": {
      "enabled": true,
      "requireEmailVerification": false,
      "passwordPolicy": {
        "minLength": 8,
        "requireUppercase": false,
        "requireLowercase": false,
        "requireNumbers": true,
        "requireSpecialChars": true,
        "maxLength": 128
      },
      "rateLimiting": {
        "loginAttempts": {
          "maxAttempts": 5,
          "windowMs": 900000,
          "lockoutDuration": 1800000
        },
        "registration": {
          "maxAttempts": 3,
          "windowMs": 3600000
        },
        "passwordReset": {
          "maxAttempts": 3,
          "windowMs": 3600000
        },
        "tokenOperations": {
          "maxAttempts": 5,
          "windowMs": 300000
        },
        "apiOperations": {
          "maxAttempts": 10,
          "windowMs": 300000
        },
        "userProfile": {
          "maxAttempts": 30,
          "windowMs": 60000
        }
      }
    },
    "imap": {
      "enabled": false,
      "domains": {
        "example.com": {
          "name": "Example Company Mail",
          "host": "mail.example.com",
          "port": 993,
          "secure": true,
          "startTLS": false,
          "requireAppPassword": false,
          "tlsOptions": {
            "_comment": "Use for self-signed certificates",
            "rejectUnauthorized": false
          }
        },
        "gmail.com": {
          "name": "Gmail",
          "host": "imap.gmail.com",
          "port": 993,
          "secure": true,
          "startTLS": false,
          "requireAppPassword": true,
          "tlsOptions": {}
        },
        "iostream.sk": {
          "name": "Example Self-Signed Certificate Server",
          "host": "mail.iostream.sk",
          "port": 143,
          "secure": false,
          "startTLS": true,
          "requireAppPassword": false,
          "tlsOptions": {
            "rejectUnauthorized": false
          },
          "_comment": "For self-signed certs, set rejectUnauthorized: false in tlsOptions"
        }
      },
      "defaultUserType": "user",
      "defaultStatus": "active"
    },
    "ldap": {
      "enabled": false,
      "servers": {
        "primary": {
          "url": "ldap://ldap.example.com:389",
          "bindDN": "cn=admin,dc=example,dc=com",
          "bindPassword": "your-bind-password",
          "searchBase": "ou=users,dc=example,dc=com",
          "searchFilter": "(mail={{email}})",
          "attributes": [
            "mail",
            "cn",
            "displayName",
            "memberOf",
            "department"
          ],
          "tls": false
        },
        "secondary": {
          "url": "ldap://ldap2.example.com:389",
          "bindDN": "cn=admin,dc=example,dc=com",
          "bindPassword": "your-bind-password",
          "searchBase": "ou=users,dc=example,dc=com",
          "searchFilter": "(mail={{email}})",
          "attributes": [
            "mail",
            "cn",
            "displayName",
            "memberOf",
            "department"
          ],
          "tls": false
        }
      },
      "defaultUserType": "user",
      "defaultStatus": "active"
    },
    "oauth2": {
      "enabled": false,
      "_comment": "OAuth2 support coming soon - for Google, Microsoft, GitHub, etc.",
      "providers": {}
    }
  },
  "jwt": {
    "secret": "CHANGE-THIS-TO-A-SECURE-RANDOM-STRING",
    "expiresIn": "7d"
  },
  "_notes": {
    "local": "Local email + password authentication (always enabled)",
    "imap": {
      "description": "IMAP authentication allows auto-creating users via email server authentication",
      "selfSignedCerts": "For self-signed certificates, set tlsOptions.rejectUnauthorized = false",
      "ports": "143 for STARTTLS, 993 for SSL/TLS",
      "gmail": "Gmail requires app-specific password with 2FA enabled"
    },
    "ldap": "LDAP authentication for corporate/enterprise directory integration",
    "oauth2": "OAuth2 for third-party authentication (planned feature)",
    "jwt": {
      "secret": "MUST be changed in production! Use a long random string",
      "expiresIn": "Token expiration time (e.g., '1d', '7d', '30d')"
    }
  }
}

