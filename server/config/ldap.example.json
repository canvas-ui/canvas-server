{
  "_comment": "LDAP Configuration Examples for Canvas Server",
  "_note": "Copy the relevant configuration to server/config/auth.json under strategies.ldap",

  "examples": {
    "activeDirectory": {
      "description": "Microsoft Active Directory configuration",
      "config": {
        "enabled": true,
        "servers": {
          "primary": {
            "url": "ldap://ad.company.com:389",
            "bindDN": "cn=ldap-reader,ou=service-accounts,dc=company,dc=com",
            "bindPassword": "service-account-password",
            "searchBase": "ou=employees,dc=company,dc=com",
            "searchFilter": "(userPrincipalName={{email}})",
            "attributes": [
              "userPrincipalName",
              "mail",
              "cn",
              "displayName",
              "memberOf",
              "department",
              "title"
            ],
            "tls": false
          }
        },
        "defaultUserType": "user",
        "defaultStatus": "active"
      }
    },

    "openLdap": {
      "description": "OpenLDAP server configuration",
      "config": {
        "enabled": true,
        "servers": {
          "primary": {
            "url": "ldap://ldap.company.local:389",
            "bindDN": "cn=admin,dc=company,dc=local",
            "bindPassword": "admin-password",
            "searchBase": "ou=users,dc=company,dc=local",
            "searchFilter": "(mail={{email}})",
            "attributes": [
              "mail",
              "cn",
              "displayName",
              "uid",
              "memberOf"
            ],
            "tls": false
          }
        },
        "defaultUserType": "user",
        "defaultStatus": "active"
      }
    },

    "secureActiveDirectoryWithTLS": {
      "description": "Active Directory with TLS/SSL (LDAPS)",
      "config": {
        "enabled": true,
        "servers": {
          "primary": {
            "url": "ldaps://ad.company.com:636",
            "bindDN": "cn=ldap-reader,ou=service-accounts,dc=company,dc=com",
            "bindPassword": "service-account-password",
            "searchBase": "dc=company,dc=com",
            "searchFilter": "(&(objectClass=user)(userPrincipalName={{email}}))",
            "attributes": [
              "userPrincipalName",
              "mail",
              "cn",
              "displayName",
              "memberOf",
              "department"
            ],
            "tls": true
          }
        },
        "defaultUserType": "user",
        "defaultStatus": "active"
      }
    },

    "multipleServersWithFailover": {
      "description": "Configuration with primary and failover LDAP servers",
      "config": {
        "enabled": true,
        "servers": {
          "primary": {
            "url": "ldap://ldap1.company.com:389",
            "bindDN": "cn=admin,dc=company,dc=com",
            "bindPassword": "password",
            "searchBase": "ou=users,dc=company,dc=com",
            "searchFilter": "(mail={{email}})",
            "attributes": ["mail", "cn", "displayName"],
            "tls": false
          },
          "secondary": {
            "url": "ldap://ldap2.company.com:389",
            "bindDN": "cn=admin,dc=company,dc=com",
            "bindPassword": "password",
            "searchBase": "ou=users,dc=company,dc=com",
            "searchFilter": "(mail={{email}})",
            "attributes": ["mail", "cn", "displayName"],
            "tls": false
          },
          "tertiary": {
            "url": "ldap://ldap3.company.com:389",
            "bindDN": "cn=admin,dc=company,dc=com",
            "bindPassword": "password",
            "searchBase": "ou=users,dc=company,dc=com",
            "searchFilter": "(mail={{email}})",
            "attributes": ["mail", "cn", "displayName"],
            "tls": false
          }
        },
        "defaultUserType": "user",
        "defaultStatus": "active"
      }
    },

    "anonymousBindSearch": {
      "description": "LDAP with anonymous search (no bind credentials required)",
      "config": {
        "enabled": true,
        "servers": {
          "primary": {
            "url": "ldap://public-ldap.company.com:389",
            "bindDN": null,
            "bindPassword": null,
            "searchBase": "ou=users,dc=company,dc=com",
            "searchFilter": "(mail={{email}})",
            "attributes": ["mail", "cn", "displayName"],
            "tls": false
          }
        },
        "defaultUserType": "user",
        "defaultStatus": "active"
      }
    }
  },

  "fieldDescriptions": {
    "url": "LDAP server URL (ldap:// or ldaps://)",
    "bindDN": "Distinguished Name for binding (service account). Use null for anonymous",
    "bindPassword": "Password for the bind DN. Use null for anonymous",
    "searchBase": "Base DN where user search begins",
    "searchFilter": "LDAP filter for finding users. {{email}} will be replaced with user's email",
    "attributes": "Array of LDAP attributes to retrieve from user entry",
    "tls": "Whether to use TLS/SSL encryption",
    "defaultUserType": "Default user type for auto-created users ('user' or 'admin')",
    "defaultStatus": "Default status for auto-created users ('active', 'pending', etc.)"
  },

  "commonSearchFilters": {
    "emailOnly": "(mail={{email}})",
    "userPrincipalName": "(userPrincipalName={{email}})",
    "uidOrEmail": "(|(uid={{email}})(mail={{email}}))",
    "activeDirectoryUser": "(&(objectClass=user)(userPrincipalName={{email}}))",
    "activeDirectoryUserEnabled": "(&(objectClass=user)(userPrincipalName={{email}})(!(userAccountControl:1.2.840.113556.1.4.803:=2)))"
  },

  "notes": {
    "installation": "LDAP authentication requires the 'ldapjs' npm package. Install with: npm install ldapjs",
    "security": "Always use LDAPS (port 636) in production for encrypted connections",
    "serviceAccount": "Create a dedicated read-only service account in your LDAP directory for Canvas to use",
    "userCreation": "Users will be automatically created in Canvas when they successfully authenticate via LDAP",
    "fallback": "If multiple servers are configured, Canvas will try them in order (primary, secondary, etc.)",
    "testing": "Test your LDAP connection with tools like ldapsearch before configuring Canvas"
  }
}

