{
  "_comment": "SMTP Configuration for Canvas Server Email Notifications",
  "_note": "Copy to server/config/smtp.json and configure with your SMTP server details",

  "enabled": false,
  "host": "smtp.example.com",
  "port": 587,
  "secure": false,
  "auth": {
    "user": "your-email@example.com",
    "pass": "your-password-or-app-token"
  },
  "from": {
    "name": "Canvas Server",
    "email": "noreply@example.com"
  },

  "_examples": {
    "gmail": {
      "enabled": true,
      "host": "smtp.gmail.com",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "your-email@gmail.com",
        "pass": "your-app-specific-password"
      },
      "from": {
        "name": "Canvas Server",
        "email": "your-email@gmail.com"
      },
      "_note": "Gmail requires app-specific password. Generate one at: https://myaccount.google.com/apppasswords"
    },

    "office365": {
      "enabled": true,
      "host": "smtp.office365.com",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "your-email@company.com",
        "pass": "your-password"
      },
      "from": {
        "name": "Canvas Server",
        "email": "your-email@company.com"
      }
    },

    "sendgrid": {
      "enabled": true,
      "host": "smtp.sendgrid.net",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "apikey",
        "pass": "YOUR_SENDGRID_API_KEY"
      },
      "from": {
        "name": "Canvas Server",
        "email": "noreply@yourdomain.com"
      }
    },

    "mailgun": {
      "enabled": true,
      "host": "smtp.mailgun.org",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "postmaster@yourdomain.mailgun.org",
        "pass": "your-mailgun-smtp-password"
      },
      "from": {
        "name": "Canvas Server",
        "email": "noreply@yourdomain.com"
      }
    },

    "customSmtpWithTLS": {
      "enabled": true,
      "host": "mail.yourdomain.com",
      "port": 465,
      "secure": true,
      "auth": {
        "user": "smtp-user@yourdomain.com",
        "pass": "smtp-password"
      },
      "from": {
        "name": "Your Company Name",
        "email": "noreply@yourdomain.com"
      }
    },

    "localSendmail": {
      "_comment": "Use local sendmail instead of SMTP server",
      "enabled": true,
      "sendmail": true,
      "newline": "unix",
      "path": "/usr/sbin/sendmail",
      "from": {
        "name": "Canvas Server",
        "email": "noreply@localhost"
      }
    }
  },

  "_fieldDescriptions": {
    "enabled": "Set to true to enable email sending",
    "host": "SMTP server hostname",
    "port": "SMTP server port (587 for TLS, 465 for SSL, 25 for plain)",
    "secure": "Use SSL/TLS from the start (true for port 465, false for port 587)",
    "auth.user": "SMTP username (usually your email address)",
    "auth.pass": "SMTP password or app-specific password",
    "from.name": "Display name for outgoing emails",
    "from.email": "Email address that emails will be sent from"
  },

  "_notes": {
    "security": "Never commit smtp.json with real credentials to version control",
    "testing": "Test email configuration with the /rest/v2/auth/verify-email endpoint",
    "ports": {
      "587": "STARTTLS (recommended)",
      "465": "SSL/TLS",
      "25": "Plain text (not recommended)"
    },
    "gmail": "Gmail requires 2FA and app-specific passwords",
    "office365": "Office 365 may require modern authentication",
    "fallback": "If SMTP is disabled, emails will be logged but not sent"
  }
}

