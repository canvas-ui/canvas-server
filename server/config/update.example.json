{
  "channel": "dev",
  "branch": "dev",
  "canvasRoot": "/opt/canvas-server",
  "canvasServerHome": "/opt/canvas-server/server",
  "canvasUser": "canvas",
  "canvasGroup": "www-data",
  "logFile": "/var/log/canvas-deploy.log",
  "lockFile": "/var/run/canvas-update.lock",
  "requiredNodeVersion": 20,
  "maintenancePage": true,
  "maintenancePort": 8001,
  "maintenanceHost": "0.0.0.0",
  "web": {
    "build": true,
    "repo": "https://github.com/canvas-ui/canvas.git",
    "branch": "main",
    "srcDir": "/opt/canvas-server/web-src"
  },
  "proxy": {
    "http": "",
    "https": "",
    "noProxy": "localhost,127.0.0.1,.local"
  }
}
